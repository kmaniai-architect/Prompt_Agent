# Copy to .env and fill in ONE provider. Without a key the app runs in offline template mode.
# Never commit .env (it is git-ignored).

# --- Groq / Gemini / OpenRouter / Ollama / OpenAI (OpenAI-compatible) ---
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
OPENAI_API_KEY=

# --- Anthropic instead ---
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-sonnet-5-5
# ANTHROPIC_API_KEY=
# ANTHROPIC_WORKSPACE_ID=

# Review loop: 0 = no reviewer (1 model call), 2 = default
REVIEW_ROUNDS=2
